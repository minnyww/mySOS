# MySOS Cloud Functions environment
# Copy to functions/.env (never committed) and fill in real values.
# Tip: `firebase functions:secrets:set NAME` is the more secure option for keys.

# LINE Messaging API (https://developers.line.biz/console) — required for LINE alerts
LINE_CHANNEL_TOKEN=your-line-messaging-api-channel-access-token
LINE_CHANNEL_SECRET=your-line-messaging-api-channel-secret

# BoostSMS (https://boost-sms.com) — required for SMS alerts.
# Leave empty to skip the SMS channel entirely.
BOOSTSMS_API_KEY=sk_live_xxxxxxxxxxxxxxxx
# Optional approved sender name; empty = provider default sender
BOOSTSMS_SENDER_NAME=

# Public base URL of the app (used for links inside messages)
APP_BASE_URL=https://mysos.example.com
