{
  "name": "functions",
  "description": "MySOS Cloud Functions — alert fan-out (FCM/LINE/SMS), pairing, LINE webhook",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes",
    "logs": "firebase functions:log",
    "test:twilio": "npm run build && node scripts/twilio-test.mjs"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.25",
    "firebase-tools": "^15.28.2",
    "typescript": "^5.6.3"
  },
  "private": true
}
